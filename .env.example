# Copy to .env. Keep .env local; never commit secret values.
GITHUB_REPOSITORY=barbarioli1/ChopTorch
GITHUB_BRANCH=main
GITHUB_ENVIRONMENT=play-internal
VERSION_CODE=4

MODEL_JSON_PATH=app/src/main/assets/choptorch_model.json
SEED_EXAMPLES_JSON_PATH=app/trainingAssets/choptorch_seed_examples.json
UPLOAD_KEYSTORE_PATH=C:/keys/choptorch-upload-key.jks
UPLOAD_KEY_ALIAS=upload

# Fill these from Google Cloud project details before using -ConfigureGoogleCloud.
GCP_PROJECT_ID=FILL_ME
GCP_PROJECT_NUMBER=FILL_ME
GCP_WORKLOAD_IDENTITY_POOL_ID=github
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=github-provider
GCP_SERVICE_ACCOUNT_ID=choptorch-play-publisher
